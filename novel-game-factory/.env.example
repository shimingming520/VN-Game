# ==================== 小说处理配置 ====================
# 要处理的小说文件名（放在 storage/raw_novels/ 目录下）
NOVEL_NAME=douluodalu.txt

# ==================== LLM 配置 ====================
# LLM 提供商（qwen, openai 等）
LLM_PROVIDER=qwen
LLM_API_FORMAT=openai
LLM_MODEL=gpt-5.6-sol

# GPT 文本和 gpt-image-2 共用同一个 FarmMX 中转站
GPT_IMAGE_BASE_URL=https://ai.farmmx.com
GPT_IMAGE_API_KEY=your_farmmx_api_key_here

# 通义千问 API Key（如果使用 qwen）
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# ==================== 数据库配置（外部 PostgreSQL）====================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=test3
DB_USER=appuser
DB_PASSWORD=your_database_password_here

# ==================== Redis 配置 ====================
REDIS_HOST=redis
REDIS_PORT=6379

# ==================== 存储路径配置 ====================
STORAGE_PATH=/app/storage
